<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.senac</groupId>
    <artifactId>organizacao-recursos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>organizacao-recursos</name>
    <description>Sistema de reservas de salas, professores e materiais sem conflito de horário</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.16</jacoco.version>
        <jacoco.min.line>0.80</jacoco.min.line>
        <jacoco.min.branch>0.70</jacoco.min.branch>
        <jsoup.version>1.22.2</jsoup.version>
        <playwright.version>1.63.0</playwright.version>

        <!-- Dependências sobrescritas por risco no SonarCloud (Dependency risks, 05/11/2026).
             O Spring Boot 3.5.16 gerencia versões mais antigas; aqui subimos só o que tem correção publicada.
             Spring Framework 6.2.19 não tem correção na linha 6.2 (ver docs/seguranca/riscos-dependencias.md). -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.22.4</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
        <logback.version>1.5.38</logback.version>
        <log4j2.version>2.25.5</log4j2.version>

        <!-- SonarCloud (o token vem do secret SONAR_TOKEN, nunca do repositório) -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>gustandrade07</sonar.organization>
        <sonar.projectKey>GustAndrade07_organizacao-recursos</sonar.projectKey>
        <!-- Inclui os templates Thymeleaf para o Sonar procurar XSS (aviso "templates not indexed") -->
        <sonar.sources>src/main/java,src/main/resources</sonar.sources>
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- O JaCoCo só mede Java: os scripts de tela (static/js) contariam como não cobertos no código novo -->
        <sonar.coverage.exclusions>**/RecursosApplication.java,**/static/js/**</sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <!-- Aplicação -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Banco de dados -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lê o HTML renderizado nos testes das telas (não depende da ordem dos atributos) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- E2E em 375 px (ADR-0004): Chromium sem tela; no CI o navegador é instalado no passo "Navegador do E2E" -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Cobertura: o build FALHA abaixo de 80% de linhas / 70% de branches -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- classe só com main(): não tem regra de negócio -->
                        <exclude>br/com/senac/recursos/RecursosApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
